<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GameTimeGuard.Service</RootNamespace>
    <AssemblyName>GameTimeGuard.Service</AssemblyName>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <Description>游戏时间守护后台服务。以 LocalSystem 运行，负责计时、锁定和结束游戏进程。</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GameTimeGuard.Core\GameTimeGuard.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\rules\platforms.json" Link="rules\platforms.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
